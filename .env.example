# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=seu_long_lived_access_token

# MQTT (broker do Home Assistant / Mosquitto)
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tello

# Tello (deixe vazio para AP padrão 192.168.10.1)
TELLO_IP=192.168.10.1