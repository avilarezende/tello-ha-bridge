# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=seu_long_lived_access_token
# Verificar TLS do HA (false apenas para certificado autoassinado local)
HA_VERIFY_TLS=true
# PERIGO: permite token Bearer em HTTP claro (evite; só LAN de teste)
HA_ALLOW_INSECURE_HTTP=false

# MQTT (broker do Home Assistant / Mosquitto)
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tello
# TLS para o broker (true; use porta 8883 em geral)
MQTT_TLS=false
# Segredo exigido em comandos HA -> app (recomendado!). O app rejeita
# comandos sem o campo "token" com este valor. Gere um valor longo e aleatório.
MQTT_COMMAND_TOKEN=

# Tello (deixe vazio para AP padrão 192.168.10.1)
TELLO_IP=192.168.10.1
# Bateria mínima (%) para decolar/iniciar procedimentos
MIN_BATTERY_PCT=15
# Bateria CRÍTICA (%) para alertar no HA
CRITICAL_BATTERY_PCT=10
