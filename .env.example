# Home Assistant
# Prefira HTTPS quando o HA expuser TLS na LAN
HA_URL=http://homeassistant.local:8123
HA_TOKEN=seu_long_lived_access_token
# false só em lab com certificado self-signed
HA_VERIFY_TLS=true

# MQTT (broker do Home Assistant / Mosquitto)
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tello
# true + porta 8883 em redes compartilhadas
MQTT_TLS=false
MQTT_TLS_INSECURE=false
# Opcional: exige {"secret":"..."} em todo comando MQTT (exceto se vazio)
MQTT_COMMAND_SECRET=

# Tello (deixe vazio para AP padrão 192.168.10.1)
TELLO_IP=192.168.10.1
